# MetricMind Environment Configuration

APP_NAME=MetricMind
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Mode: demo | production
METRICMIND_MODE=demo

# LLM Provider Configuration (Optional in Demo Mode)
LLM_PROVIDER=mock_llama3
LLM_API_KEY=
LLM_MODEL=llama3-70b-instruct
LLM_TEMPERATURE=0.1

# Semantic Layer Backend (Optional - defaults to Governed Mock Semantic Engine)
SEMANTIC_LAYER_TYPE=governed_mock
CUBE_API_URL=
CUBE_API_SECRET=
DBT_CLOUD_URL=
DBT_SERVICE_TOKEN=

# Data Warehouse (Optional - defaults to In-Memory Corporate Data Engine)
DATABASE_URL=sqlite:///./metricmind_dw.db
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
